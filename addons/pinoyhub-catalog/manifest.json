{
  "id": "community.pinoyhub.catalog",
  "version": "1.0.0",
  "name": "PinoyHub Catalog",
  "description": "Browse Pinoy movies and Tagalog-dubbed series from pinoymovieshub.win. Titles resolve to TMDB ids; pair with the PinoyMoviesHub plugin for playback.",
  "logo": "https://pinoymovieshub.win/wp-content/uploads/2025/04/cropped-favicon-11-192x192.png",
  "resources": [
    "catalog"
  ],
  "types": [
    "movie",
    "series"
  ],
  "idPrefixes": [
    "tmdb:"
  ],
  "catalogs": [
    {
      "type": "movie",
      "id": "pinoy-movies",
      "name": "Pinoy Movies",
      "pageSize": 20,
      "extra": [
        {
          "name": "search"
        },
        {
          "name": "skip"
        }
      ]
    },
    {
      "type": "movie",
      "id": "pinoy-movies-genre",
      "name": "Pinoy Movies by Genre",
      "pageSize": 20,
